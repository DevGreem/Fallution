[gd_scene format=3]

[ext_resource type="Script" path="res://addons/library_manager/ui/library_stack_dialog.gd" id="1"]

[node name="LibraryStackDialog" type="Window"]
oversampling_override = 1.0
title = "New LibraryStack"
size = Vector2i(560, 560)
visible = false
exclusive = true
min_size = Vector2i(460, 420)
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="VBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Title" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "LibraryStack"

[node name="Hint" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.66, 0.72, 1)
theme_override_font_sizes/font_size = 12
text = "Name the stack and check the libraries it should include."
autowrap_mode = 3

[node name="HeaderSep" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="NameRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NameLabel" type="Label" parent="Margin/VBox/NameRow"]
layout_mode = 2
text = "Name:"

[node name="NameEdit" type="LineEdit" parent="Margin/VBox/NameRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "My Library Stack"

[node name="Content" type="MarginContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Tree" type="Tree" parent="Margin/VBox/Content"]
layout_mode = 2
columns = 2
column_titles_visible = true
hide_root = true
select_mode = 1

[node name="EmptyState" type="Label" parent="Margin/VBox/Content"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.63, 0.68, 1)
theme_override_font_sizes/font_size = 13
text = "No libraries found in the storage folder."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="ErrorLabel" type="Label" parent="Margin/VBox"]
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.45, 0.45, 1)
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="ButtonBar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="StatusLabel" type="Label" parent="Margin/VBox/ButtonBar"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_override_colors/font_color = Color(0.62, 0.66, 0.72, 1)
theme_override_font_sizes/font_size = 12
text = "0 included"

[node name="SaveButton" type="Button" parent="Margin/VBox/ButtonBar"]
layout_mode = 2
text = "Save"

[node name="CancelButton" type="Button" parent="Margin/VBox/ButtonBar"]
layout_mode = 2
text = "Cancel"

[connection signal="close_requested" from="." to="." method="_on_close_requested"]
[connection signal="item_edited" from="Margin/VBox/Content/Tree" to="." method="_on_item_edited"]
[connection signal="pressed" from="Margin/VBox/ButtonBar/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="Margin/VBox/ButtonBar/CancelButton" to="." method="_on_cancel_pressed"]
