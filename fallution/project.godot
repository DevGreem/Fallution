; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fallution"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameDebugger="*uid://xodsxgpsskk2"
LivePaletteRuntime="*uid://d31r5bjbh1oer"
PhantomCameraManager="*uid://duq6jhf6unyis"
ComponentManager="*uid://dhg8bupj1ups7"
TransitionManager="*uid://cno4wejckrna6"
ScenesManager="*uid://qqccb5c6n424"
AudioManager="*uid://dsxatc6se2tjn"
PlayerManager="*uid://dst27tilrrgpj"
GlobalBuffManager="*uid://2kvq0g2qoer5"
SpawnManager2D="*uid://cbo65ipsnkm67"
UIManager="*uid://dby5u3bvyp14j"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://script_templates": 0
}
gdscript/warnings/shadowed_variable=2
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/shadowed_global_identifier=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/confusable_local_declaration=2
gdscript/warnings/confusable_local_usage=2

[display]

window/size/viewport_width=256
window/size/viewport_height=144
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

naming/scene_name_casing=1

[editor_plugins]

enabled=PackedStringArray("res://.godot/scenetime/plugin.cfg", "res://addons/at-icons/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/live_palette/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/scene_palette/plugin.cfg", "res://addons/yard/plugin.cfg")

[global_group]

entities=""
leafs=""

[input]

left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)
]
}
right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Entities"
2d_physics/layer_3="LeafInteractions"
2d_physics/layer_4="Interactions"
2d_physics/layer_5="Leafs"

[navigation]

pathfinding/max_threads=-1

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
